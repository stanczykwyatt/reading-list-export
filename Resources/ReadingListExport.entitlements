<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Everything Reading List Export is allowed to do. The App Sandbox blocks anything not listed here.
	There is no network entitlement, so it cannot connect to the internet at all, and no Apple
	Events, so it cannot control other apps, Safari included.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read-only access to Safari's bookmarks file, where the Reading List is kept, and nothing
	     else: not your history, open tabs, passwords or the rest of Safari's folder. macOS also
	     requires Full Disk Access for it, which you turn on. Writing there is blocked.
	     Sources/ReadingListCore/Bookmarks.swift names the same file, and a test checks the two match. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Safari/Bookmarks.plist</string>
	</array>
	<!-- Read and write access to the folder you choose to export to, or the file you save the
	     bookmarks file as, and nothing else. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Lets the app remember that folder after it quits, instead of asking every time. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
